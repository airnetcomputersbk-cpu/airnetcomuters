{
  "version": 2,
  "installCommand": "unzip -o -q airnet-deploy.zip && pnpm install",
  "buildCommand": "unzip -o -q airnet-deploy.zip && node patch.js",
  "outputDirectory": "artifacts/airnet-computers/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "30 17 * * *"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
